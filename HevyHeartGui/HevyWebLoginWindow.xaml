<Window x:Class="HevyHeartGui.HevyWebLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Log in to Hevy"
        Height="750" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1a1a2e" Padding="12,8">
            <TextBlock Text="Log in to Hevy — your tokens will be captured automatically"
                       Foreground="#aaaaaa"
                       FontSize="11"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- WebView2 browser -->
        <wv2:WebView2 x:Name="WebView"
                      Grid.Row="1"
                      Source="https://hevy.com/login"/>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#111111" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusText"
                           Text="Waiting for login..."
                           Foreground="#888888"
                           FontSize="11"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="SpinnerText"
                           Text=" ⏳"
                           Foreground="#888888"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Visibility="Visible"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
